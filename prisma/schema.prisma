datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName  String
  middleName String?
  lastName   String
  email      String   @unique
  phone      String?
  role       Role     @default(ADMIN)
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  subject   String
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
